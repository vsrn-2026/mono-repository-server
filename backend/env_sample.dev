PORT=8080
CORS_ORIGIN=http://localhost:8080

#DB URL
DATABASE_URL="" #dev

#Environment Mode
NODE_ENV=development

#Logging Level
LOG_LEVEL='error'

#JWT
JWT_ACCESS_SECRET='dev-access-secret-change-in-production'
JWT_REFRESH_SECRET='dev-refresh-secret-change-in-production'
