JWT_REFRESH_EXPIRES_IN='7d'

#Redis
REDIS_HOST='localhost'
REDIS_PORT='6379'
REDIS_PASSWORD=''

# Grafana
GF_SECURITY_ADMIN_PASSWORD=''
GF_USERS_ALLOW_SIGN_UP=false